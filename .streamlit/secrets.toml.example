[serviceplan]
mode = "hosted"
database_schema = "serviceplan"
# Dedicated serviceplan database, pooled endpoint, TLS. Replace privately in Streamlit Secrets.
database_url = "postgresql://ROLE:PASSWORD@ENDPOINT-pooler.eu-central-1.aws.neon.tech/serviceplan?sslmode=require"
# Omit users for the documented synthetic portfolio accounts.
# For a restricted review, provide the complete user list; hashes generated offline:
# [[serviceplan.users]]
# user_id = "SP-owner"
# email = "owner@example.test"
# display_name = "Owner"
# role = "admin"
# password_hash = "pbkdf2_sha256$210000$SALT$DIGEST"
# [[serviceplan.users]]
# user_id = "SP-customer"
# email = "customer@example.test"
# display_name = "Customer"
# role = "customer"
# customer_id = "CUS-0000"
# password_hash = "pbkdf2_sha256$210000$SALT$DIGEST"
